# JARVIS provider API keys — copy this file to `.env` and fill in what you have.
# Every key is OPTIONAL. Providers without a key show a clear "not configured"
# message in the dashboard instead of crashing.
# NOTE: keep comments on their OWN lines — no text after the `=`.

# Brain: Gemini (default, free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Brain: OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Brain: Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Brain: OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama needs no key — just have the local server running (http://localhost:11434)

# TTS: ElevenLabs (preferred voice once set) — https://elevenlabs.io/
ELEVENLABS_API_KEY=

# pyttsx3 / edge-tts / Google Web Speech / local Whisper need no keys.
# OpenAI Whisper API reuses OPENAI_API_KEY.
