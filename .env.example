# JARVIS provider API keys — copy this file to `.env` and fill in what you have.
# Every key is OPTIONAL. Providers without a key show a clear "not configured"
# message in the dashboard instead of crashing.

# --- Brain providers ---
GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (default brain, free tier)
OPENAI_API_KEY=            # https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=         # https://console.anthropic.com/
OPENROUTER_API_KEY=        # https://openrouter.ai/keys
# Ollama needs no key — just have the local server running (http://localhost:11434)

# --- Voice output (TTS) ---
ELEVENLABS_API_KEY=        # https://elevenlabs.io/  (preferred voice once set)
# pyttsx3 and edge-tts need no key

# --- Voice input (STT) ---
# Google Web Speech needs no key. Local Whisper needs no key.
# OpenAI Whisper API reuses OPENAI_API_KEY above.
